{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "schedule:earlyMondays",
    "github>lkshrk/gh-ops//renovate/presets/groups.json5",
  ],
  minimumReleaseAge: "48 hours",
  rangeStrategy: "replace",
  rebaseWhen: "behind-base-branch",
  automergeType: "pr",
  automergeStrategy: "squash",
  platformAutomerge: true,
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  packageRules: [
    {
      matchUpdateTypes: ["patch", "minor", "pin", "digest"],
      automerge: true,
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
      automerge: true,
    },
    {
      matchDepTypes: ["engines"],
      enabled: false,
    },
  ],
  npm: {
    ignorePaths: [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "*/**/tests/**",
      "tests/*/**",
      "**/__fixtures__/**",
    ],
  },
  bun: {
    ignorePaths: [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "*/**/tests/**",
      "tests/*/**",
      "**/__fixtures__/**",
    ],
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    automergeType: "branch",
    schedule: ["before 4am on sunday"],
  },
}
