{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>lkshrk/gh-ops//renovate/presets/default.json5",
    "github>lkshrk/gh-ops//renovate/presets/github-actions.json5",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
  ],
  ignorePaths: [
    "**/*.sops.*",
    "**/resources/**",
  ],
  npm: {
    ignorePaths: [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "*/**/tests/**",
      "tests/*/**",
      "**/__fixtures__/**",
      "**/*.sops.*",
      "**/resources/**",
    ],
  },
  bun: {
    ignorePaths: [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/examples/**",
      "**/__tests__/**",
      "**/test/**",
      "*/**/tests/**",
      "tests/*/**",
      "**/__fixtures__/**",
      "**/*.sops.*",
      "**/resources/**",
    ],
  },
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  dockerfile: {
    managerFilePatterns: ["/(?:^|/)Dockerfile$/"],
  },
}
