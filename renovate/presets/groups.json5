{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Keep runtime references and tightly coupled framework/browser packages together",
  packageRules: [
    {
      matchDatasources: ["docker", "node-version", "github-releases"],
      matchPackageNames: ["node", "actions/node-versions", "docker.io/node", "docker.io/library/node", "index.docker.io/library/node"],
      groupName: "Node.js",
      groupSlug: "nodejs",
      separateMajorMinor: false,
      separateMultipleMajor: false,
      separateMultipleMinor: false,
      separateMinorPatch: false,
    },
    {
      matchDatasources: ["npm", "docker"],
      matchPackageNames: ["bun", "oven/bun", "docker.io/oven/bun"],
      groupName: "Bun",
      groupSlug: "bun",
      separateMajorMinor: false,
      separateMultipleMajor: false,
      separateMultipleMinor: false,
      separateMinorPatch: false,
    },
    {
      matchDatasources: ["npm", "docker"],
      matchPackageNames: [
        "@playwright/test",
        "playwright",
        "playwright-core",
        "@playwright/browser-chromium",
        "@playwright/browser-firefox",
        "@playwright/browser-webkit",
        "@playwright/experimental-ct-*",
        "mcr.microsoft.com/playwright",
      ],
      groupName: "Playwright",
      groupSlug: "playwright",
      separateMajorMinor: false,
      separateMultipleMajor: false,
      separateMultipleMinor: false,
      separateMinorPatch: false,
    },
    {
      matchDatasources: ["npm"],
      matchPackageNames: [
        "@sveltejs/kit",
        "@sveltejs/adapter-*",
        "@sveltejs/vite-plugin-svelte*",
        "svelte",
      ],
      groupName: "SvelteKit",
      groupSlug: "sveltekit",
      separateMajorMinor: false,
      separateMultipleMajor: false,
      separateMultipleMinor: false,
      separateMinorPatch: false,
    },
    {
      description: "These applications use Vite as part of their SvelteKit toolchain",
      matchRepositories: [
        "webdev-harke/ISC",
        "webdev-harke/pfalz-herz",
        "webdev-harke/pizzeria-riva",
        "webdev-harke/quintessenz-horst",
      ],
      matchDatasources: ["npm"],
      matchPackageNames: ["vite"],
      groupName: "SvelteKit",
      groupSlug: "sveltekit",
      separateMajorMinor: false,
      separateMultipleMajor: false,
      separateMultipleMinor: false,
      separateMinorPatch: false,
    },
  ],
}
