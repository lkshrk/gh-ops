{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "GitHub Actions and runner images: update any time, group non-majors, open majors as PRs",
  extends: [
    "github>lkshrk/gh-ops//renovate/presets/groups.json5",
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Blacksmith runner labels follow the GitHub-hosted Ubuntu images",
      managerFilePatterns: ["/(^|/)\\.github/(workflows|actions)/.+\\.ya?ml$/"],
      matchStrings: [
        "(?<prefix>blacksmith-\\d+vcpu-ubuntu-)(?<major>\\d{2})(?<minor>\\d{2})(?<arch>-arm)?\\b",
      ],
      depNameTemplate: "blacksmith-ubuntu",
      packageNameTemplate: "ubuntu",
      datasourceTemplate: "github-runners",
      versioningTemplate: "docker",
      currentValueTemplate: "{{{major}}}.{{{minor}}}{{{arch}}}",
      autoReplaceStringTemplate: "{{{prefix}}}{{{replace '\\.' '' newValue}}}",
    },
  ],
  packageRules: [
    {
      matchFileNames: [".github/workflows/**", ".github/actions/**"],
      schedule: ["at any time"],
    },
    {
      matchFileNames: [".github/workflows/**", ".github/actions/**"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest"],
      matchPackageNames: [
        "!node",
        "!actions/node-versions",
        "!docker.io/node",
        "!docker.io/library/node",
        "!index.docker.io/library/node",
        "!bun",
        "!oven/bun",
        "!docker.io/oven/bun",
        "!@playwright/test",
        "!playwright",
        "!playwright-core",
        "!@playwright/browser-*",
        "!@playwright/experimental-ct-*",
        "!mcr.microsoft.com/playwright",
      ],
      groupName: "github actions",
    },
    {
      matchFileNames: [".github/workflows/**", ".github/actions/**"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: false,
      automerge: false,
    },
  ],
}
